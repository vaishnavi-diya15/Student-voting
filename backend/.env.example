# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Port the API listens on
PORT=5000

# Origin of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Database name: student_voting
#   Local:  mongodb://127.0.0.1:27017/student_voting
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>/student_voting
MONGO_URI=

# SMTP settings for OTP email delivery
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# OTP validity in minutes
OTP_EXPIRY_MINUTES=5

# Optional persistent HMAC secret; generate a long random value for production
OTP_HASH_SECRET=
